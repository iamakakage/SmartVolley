{
	"QMainWindow":[
		{
			"tittle":"SmartVolley",
			"icon":":/logos/logos/1.png",
			"frameless": true,
			"transluscentBg": true,
			"sizeGrip": "sizeGrip",
			"navigation":[
				{
					"minimize":"minimizeBtn",
					"close": "closeBtn",
					"restore":[
						{
							"buttonName": "restoreBtn",
							"normalIcon": ":/icons-dark/icons/dark/square.svg",
							"maximizedIcon": ":/icons-dark/icons/dark/copy.svg"
						}
					],
					"moveWindow": "headerContainer",
					"tittleBar": "headerContainer"
				}
			]
		}
	],
	"QCustomSlideMenu": [
		{
			"name": "leftMenuContainer",
			"defaultSize": [{
				"width": 45,
				"height": "parent"
			}],
			"collapsedSize": [{
				"width": 45,
				"height": "parent"
			}],
			"expandedSize": [{
				"width": 150,
				"height": "parent"
			}],
			"toggleButton": [{
				"buttonName": "menuBtn",
				"icons": [{
					"whenMenuIsCollapsed": ":/icons-dark/icons/dark/align-justify.svg",
					"whenMenuIsExpanded": ":/icons-dark/icons/dark/chevron-left.svg"
				}]
			}],
			"menuTransitionAnimation": [{
				"animationDuration": 100,
				"animationEasingCurve": "Linear"
			}]
		},
		{
			"name": "centerMenuContainer",
			"defaultSize": [{
				"width": 0,
				"height": "parent"
			}],
			"collapsedSize": [{
				"width": 0,
				"height": "parent"
			}],
			"expandedSize": [{
				"width": 200,
				"height": "parent"
			}],
			"menuTransitionAnimation": [{
				"animationDuration": 100,
				"animationEasingCurve": "Linear"
			}]
		},
		{
			"name": "rightMenuContainer",
			"defaultSize": [{
				"width": 0,
				"height": "parent"
			}],
			"collapsedSize": [{
				"width": 0,
				"height": "parent"
			}],
			"expandedSize": [{
				"width": 200,
				"height": "parent"
			}],
			"menuTransitionAnimation": [{
				"animationDuration": 100,
				"animationEasingCurve": "Linear"
			}]
		},
		{
			"name": "camControllerMenuSubContainer",
			"defaultSize": [{
				"width": 0,
				"height": "parent"
			}],
			"collapsedSize": [{
				"width": 0,
				"height": "parent"
			}],
			"expandedSize": [{
				"width": 165,
				"height": "parent"
			}],
			"menuTransitionAnimation": [{
				"animationDuration": 100,
				"animationEasingCurve": "Linear"
			}]
		},
		{
			"name": "popupNotificationContainer",
			"defaultSize": [{
				"width": 0,
				"height": "auto"
			}],
			"collapsedSize": [{
				"width": 0,
				"height": "auto"
			}],
			"expandedSize": [{
				"width": 800,
				"height": 120
			}],
			"menuTransitionAnimation": [{
				"animationDuration": 100,
				"animationEasingCurve": "Linear"
			}],
			"floatPosition": [
				{
					"relativeTo": "centralwidget",
					"position": "bottom-center",
					"shadow":[
						{
							"color": "#000",
							"blurRadius": 20,
							"xOffset": 0,
							"yOffset": 0
						}
					]
				}
			],
			"toggleButton": [{
				"buttonName": "notificationBtn"
			}]
		}
	],
	"QCustomQStackedWidget":[
		{
			"name":"mainPages",
			"navigation":[
				{
					"navigationButtons":[
						{
							"matchBtn": "page_9",
							"camBtn": "page_6",
							"dataBtn": "page_7",
							"reportBtn": "page_8"
						}
					]
				}
			]

		},
		{
			"name":"rightMenuPages",
			"navigation":[
				{
					"navigationButtons":[
						{
							"profileMenuBtn": "page_4",
							"moreMenuBtn": "page_5"
						}
					]
				}
			]

		},
		{
			"name":"centerMenuPages",
			"navigation":[
				{
					"navigationButtons":[
						{
							"settingsBtn": "page",
							"infoBtn": "page_2",
							"helpBtn": "page_3"
						}
					]
				}
			]

		}
	],
	"QPushButtonGroup": [
		{
			"Buttons": [
				"matchBtn",
				"camBtn",
				"dataBtn",
				"reportBtn"
			],
			"Style":[{
				"Active": "background-color: #a2b9ee;",
				"NotActive": ""
			}]
		},
		{
			"Buttons": [
				"settingsBtn",
				"infoBtn",
				"helpBtn"
			],
			"Style":[{
				"Active": "background-color: #a2dcee;",
				"NotActive": ""
			}]
		}
	]
}